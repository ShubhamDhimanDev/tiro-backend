APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Dedicated HMAC key for customer OTP code hashing — deliberately separate
# from APP_KEY (see config/otp.php). Generate a fresh value per environment,
# e.g. `php -r "echo bin2hex(random_bytes(32));"`.
OTP_HMAC_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev runs MySQL (matching production), via the standalone
# `tiro-mysql` docker container — not the sqlite default this starter kit
# ships with. See ../docker-compose.yml's header for the container's exact
# `docker run` command if it needs recreating.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiro
DB_USERNAME=root
DB_PASSWORD=changeme

# Meilisearch (Laravel Scout driver — meilisearch/meilisearch-php). Run via
# the root docker-compose.yml (`docker compose up -d meilisearch`). Get the
# key from the root .env's MEILI_MASTER_KEY (or `docker compose exec
# meilisearch env | grep MEILI_MASTER_KEY`) — the two must match.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is OPTIONAL. The defaults above (database cache/queue/locks/sessions)
# need no Redis at all. To opt in for production/load, set CACHE_STORE=redis
# and/or QUEUE_CONNECTION=redis (and SESSION_DRIVER=redis) and uncomment the
# block below. predis (pure PHP, no extension) is the client; it is only
# touched when a Redis store is actually selected.
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Internal recipient for storefront enquiries (contact/quote/fleet/notify-me); blank = store only.
MAIL_ENQUIRIES_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (cards/Apple Pay/Google Pay/Afterpay — see
# docs/architecture/03-integrations.md item 3). Test-mode keys are
# self-serve/free from dashboard.stripe.com (toggle test mode) — no business
# approval needed to develop/test against them. STRIPE_WEBHOOK_SECRET is a
# distinct per-endpoint credential (or the Stripe CLI's own secret for local
# `stripe listen` testing), not the same value as STRIPE_SECRET_KEY. Real
# keys are a local .env-only secret — never commit them.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Which payment gateway is active for brand-new payments — see
# config/services.php's `payment_gateway` key,
# App\Providers\AppServiceProvider::register(). `stripe` or `paypal` (`zip`
# stays reserved/unbuilt). An unrecognized value is a hard RuntimeException
# at boot.
PAYMENT_GATEWAY=stripe

# PayPal (second gateway, alongside Stripe — see
# docs/architecture/03-integrations.md's PayPal section, config/services.php's
# `paypal` block). PAYPAL_MODE selects the REST base URL (sandbox vs. live)
# and must always agree with which client_id/client_secret/webhook_id triple
# is configured below — a mismatch silently fails every API call/webhook
# verification. PAYPAL_WEBHOOK_ID is obtained from the PayPal Developer
# Dashboard when registering the webhook URL, one per environment. No
# PayPal credentials of any kind exist in this workspace yet (see
# docs/architecture/06-open-decisions.md item 24) — real keys are a local
# .env-only secret, never commit them.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Frontend (Next.js) on-demand ISR revalidation webhook — see
# config/services.php's `services.frontend` block for the full contract.
# `FRONTEND_REVALIDATE_URL` should always resolve to
# `{next-js-origin}/api/revalidate` — mirror however this environment
# already reaches the Next.js app (plain `http://localhost:3000/...` for two
# native dev processes, or the Compose service name, e.g.
# `http://node:3000/...`, once both apps run inside docker-compose.yml's
# `app`/`node` services). `FRONTEND_REVALIDATE_SECRET` is a real random
# value per environment (`openssl rand -hex 32` or equivalent) and must be
# byte-for-byte identical to frontend's REVALIDATE_WEBHOOK_SECRET — a
# mismatch silently 401s every webhook call, masked by the existing timed
# ISR window, so double check both sides after rotating either one.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# Resend (transactional email) — Phase 7, docs/architecture/03-integrations.md
# item 4. `resend/resend-laravel` (the official package) is installed and
# registers the `resend` mail transport itself; it reads this same
# RESEND_API_KEY via config/services.php's `resend.key`. MAIL_MAILER below
# stays `log` until a real key exists (self-serve signup — the business's
# job to obtain, not devops-agent's to provision) — flipping it without a
# working key would silently break all outgoing mail, same reasoning
# Mailpit is left unwired below.
RESEND_API_KEY=
# Disables the package's own auto-registered `/resend/webhook` route — no
# delivery-webhook ingestion this phase (see `NotificationLog`'s docblock).
RESEND_ROUTES=false

# MessageMedia (SMS) — Phase 7, docs/architecture/03-integrations.md item 4,
# config/services.php's `messagemedia` block, consumed by
# App\Services\Notifications\MessageMediaClient. api_key/api_secret are HTTP
# Basic Auth credentials (MessageMedia's own dashboard terminology — "API
# key"/"API secret" — not an HMAC pair). MessageMedia sandbox/developer
# access is unconfirmed on the business side as of this phase (see
# docs/architecture/06-open-decisions.md item 21), so these two commonly
# stay blank — every call site is covered by Http::fake() in tests, never a
# live call without them. base_url isn't a secret, so unlike the two above
# it's set to the real documented production endpoint (matches
# config/services.php's own fallback) rather than left blank.
MESSAGEMEDIA_API_KEY=
MESSAGEMEDIA_API_SECRET=
MESSAGEMEDIA_BASE_URL=https://api.messagemedia.com/v1

# Google Business Profile reviews sync (Phase 8) — see
# config/services.php's `services.google_reviews` block,
# App\Console\Commands\SyncGoogleReviewsCommand. OAuth 2.0 user-delegated
# consent, not a service account/static key: a real person managing Tiro's
# GBP listing must click through a one-time consent grant
# (`business.manage` scope) before GOOGLE_REVIEWS_REFRESH_TOKEN exists —
# external lead time, tracked separately. All five stay blank until that
# happens; every call site is covered by Http::fake() in tests, never a
# live call without them.
GOOGLE_REVIEWS_CLIENT_ID=
GOOGLE_REVIEWS_CLIENT_SECRET=
GOOGLE_REVIEWS_REFRESH_TOKEN=
GOOGLE_REVIEWS_ACCOUNT_ID=
GOOGLE_REVIEWS_LOCATION_ID=

# How many days a pre-purchase (order_id null) approved PriceGuaranteeClaim
# stays usable — see docs/architecture/05-promotions-pricing.md's
# "Price-guarantee claim workflow" section. Optional, defaults to 30.
PRICE_GUARANTEE_REDEMPTION_DAYS=30

VITE_APP_NAME="${APP_NAME}"

# Business details interpolated into the seeded legal/contact pages
# (config/business.php). Leave blank until the owner supplies real values —
# the copy then falls back to wording that needs none (no placeholders shown).
BUSINESS_ABN=
BUSINESS_SUPPORT_EMAIL=
BUSINESS_PRIVACY_EMAIL=
BUSINESS_SUPPORT_PHONE=
BUSINESS_SUPPORT_HOURS="8am to 5pm"
BUSINESS_GOVERNING_STATE=Victoria
