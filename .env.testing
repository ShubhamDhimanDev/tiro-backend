# Loaded automatically by Laravel for any test run (APP_ENV=testing is
# implied by PHPUnit/Pest's runningUnitTests() check — no flag needed).
# These are the *default, shared* test-suite settings, safe for a single
# agent's narrow `--filter=testName` loop against the existing `tiro_testing`
# schema on the shared `tiro-mysql` container.
#
# For a FULL suite run or anything that could run concurrently with another
# agent's test run (another Pest suite, another migrate:fresh, etc.), do not
# rely on this file directly — use `scripts/test-db.sh run -- <command>`
# instead, which overrides DB_DATABASE below with a private
# `tiro_testing_<random>` schema for that invocation only (real process env
# vars beat this file's values; Laravel's dotenv won't clobber something
# already set — see scripts/test-db.sh's own comments for why this approach
# was chosen over Laravel's --env flag, which does NOT reliably override
# under PHPUnit's runningUnitTests() env-loading path — verified empirically
# 2026-09-11, not assumed).
#
# Keep DB_* here in sync with backend/.env's credentials (same tiro-mysql
# server, different database name) if those ever change.
APP_ENV=testing

# Was missing entirely before this file existed — no APP_KEY line anywhere,
# so Laravel's encrypter had no key at all ("No application encryption key
# has been specified"). This broke any test touching encrypt()/decrypt(),
# including tests/Pest.php's shared actingSuperAdmin() helper (via
# UserFactory::withTwoFactor()'s encrypt('secret') call) — meaning most of
# the suite was silently failing on this, not a small isolated case.
# Dedicated test-only value generated fresh via
# `php artisan key:generate --show`, not copied from backend/.env's real
# production-facing key.
APP_KEY=base64:+tsVrw5sv30I1hssqomtWTDTQOFYZMzM85KjtbDHet0=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null
CACHE_STORE=array

# Was missing entirely before this file existed (phpunit.xml never set it
# either) — 1 test (CustomerAuthTest registration-OTP flow) was failing with
# a 500 for this reason, confirmed pre-existing/unrelated to the DB-isolation
# work in this file, not something introduced by it. Dedicated value, not
# copied from backend/.env's real OTP_HMAC_KEY.
OTP_HMAC_KEY=f121abcb7f9df0a84e713394bf87bf410643af38635a4ac7ecfffac032a1ddc7

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiro_testing
DB_USERNAME=root
DB_PASSWORD=tiro_local_dev_pw
DB_URL=

MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Scout syncs to the search engine synchronously (QUEUE_CONNECTION=sync
# above) on every model save/delete; "null" keeps tests fast and independent
# of whether the real Meilisearch server is reachable, without needing
# per-test withoutSyncingToSearch() calls.
SCOUT_DRIVER=null

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
